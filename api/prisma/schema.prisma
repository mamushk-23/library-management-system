// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      Role     @default(PATRON)
  reviews   Review[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  isbn      String   @unique
  genreId   Int
  genre     Genre    @relation(fields: [genreId], references: [id])
  reviews   Review[]
}

// Stretch Goal: Review Model
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // e.g., 1 to 5
  comment   String?
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  // A user should only be able to leave one review per book
  @@unique([bookId, userId]) 
}